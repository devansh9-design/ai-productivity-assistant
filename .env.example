# Public Supabase project settings. These values are safe to use in the browser;
# never add SUPABASE_SERVICE_ROLE_KEY or other private credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only: Supabase service-role key for credential storage (Day 6).
# NEVER prefix with NEXT_PUBLIC_. Used only in lib/supabase/service-role.ts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only: shared secret required by POST /api/telegram/checkin.
TELEGRAM_CHECKIN_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Server-only: Google OAuth credentials for Calendar read integration (Day 6).
# NEVER prefix with NEXT_PUBLIC_. Used only in lib/google/oauth.ts.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Server-only: OpenAI Responses API key for the AI planning assistant.
OPENAI_API_KEY=your-openai-api-key
# Optional model override. Defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna
